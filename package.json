{
  "name": "dsh-mini-sync",
  "version": "0.3.0",
  "description": "Minimal DSH config sync to your own WebDAV: providers, API keys, base URLs, plugins and settings — with optional encryption, remote file browsing and deletion, never conversations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToddModica/dsh-mini-sync.git"
  },
  "homepage": "https://github.com/ToddModica/dsh-mini-sync#readme",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "webdav",
    "sync",
    "config"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  }
}
